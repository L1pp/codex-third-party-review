# Local settings and credentials
config.json
*.local.json
.env
.env.*
!.env.example
credentials*.json

# Review packets, provider responses and call metadata are private by default
logs/
outputs/
artifacts/
reviews/
.review/
packet.json
packet-*.json
materials.json
request.json
token_budget.json
progress.json
report.md
result.json
workflow.json
response_stream.jsonl
response_metadata.json
response_body.bin
reasoning.txt
checkpoint.txt
*.sqlite3
*.sqlite3-*

# Local public-catalog cache; refresh explicitly when needed
assets/bailian_catalog_cache.json

# Optional upstream tokenizer files are installed locally, never vendored
assets/deepseek_v4_tokenizer/*
!assets/deepseek_v4_tokenizer/README.md

# Python tooling
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.coverage
htmlcov/

# Derived review diagnostics, verdicts and captured source records
report_diagnostics.json
adjudication.json
adjudication-input*.json
private-decisions.json
**/sources/index.json
**/sources/source-*.txt

# Full local tool deliveries before request-history cleanup
tool_results.jsonl
checkpoints/

# Uncommitted private JSON payloads retained after a failed local commit
*.json.*.tmp
*.json.tmp

# Safe local file-failure locator events
local_io_errors.jsonl

# Cross-process review provenance (local only)
resume-state.json

# Isolated official Harness runtime dependencies and local session storage
node_modules/
runtime/package-lock.json
engine-session/
session-header.json
session.jsonl
writer.lock

# Private compact runtime audit and clock records
call_history.jsonl
review_timing.jsonl
material_delivery_index.json
audit.json
